{
  "name": "minha-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:unit": "vitest --run --project=unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:e2e": "playwright test --config playwright/playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config playwright/playwright.config.ts --headed",
    "test:e2e:storybook": "E2E_TEST_TYPE=storybook playwright test --config playwright/playwright.config.ts",
    "test:e2e:storybook:ui": "E2E_TEST_TYPE=storybook playwright test --config playwright/playwright.config.ts --ui",
    "test:e2e:components": "E2E_TEST_TYPE=storybook playwright test --config playwright/playwright.config.ts tests/components",
    "test:e2e:hooks": "E2E_TEST_TYPE=storybook playwright test --config playwright/playwright.config.ts tests/hooks",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "plop": "plop --plopfile ./plop/plopfile.cjs",
    "precommit": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^10.6.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
