{
  "name": "minha-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:coverage": "pnpm --filter @minha-ui/react exec vitest run --project=unit --coverage",
    "test:e2e": "pnpm --filter @minha-ui/react test:e2e",
    "test:e2e:ui": "pnpm --filter @minha-ui/react test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @minha-ui/react test:e2e:headed",
    "test:e2e:storybook": "pnpm --filter @minha-ui/react test:e2e:storybook",
    "test:e2e:storybook:ui": "pnpm --filter @minha-ui/react test:e2e:storybook:ui",
    "test:e2e:components": "pnpm --filter @minha-ui/react test:e2e:components",
    "test:e2e:hooks": "pnpm --filter @minha-ui/react test:e2e:hooks",
    "storybook": "pnpm --filter @minha-ui/react storybook",
    "build-storybook": "pnpm --filter @minha-ui/react build-storybook",
    "plop": "pnpm --filter @minha-ui/react plop",
    "precommit": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
