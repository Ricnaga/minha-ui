{
  "name": "@minha-ui/svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json",
    "test:unit": "vitest --run --project=unit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "plop": "plop --plopfile ./plop/plopfile.cjs"
  },
  "dependencies": {
    "@minha-ui/theme": "workspace:*",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/svelte-vite": "^10.6.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^10.6.3",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
